{
  "name": "binaroo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "assets": "node scripts/make-resources.mjs && capacitor-assets generate --ios --android --iconBackgroundColor '#070d1a' --iconBackgroundColorDark '#070d1a' --splashBackgroundColor '#070d1a' --splashBackgroundColorDark '#070d1a'",
    "sync": "npm run build && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "ios:sim": "bash scripts/ios-sim.sh",
    "android:emu": "bash scripts/android-emu.sh",
    "ios:shot": "xcrun simctl io booted screenshot ~/Desktop/binaroo-ios.png && echo Saved ~/Desktop/binaroo-ios.png"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/jetbrains-mono": "^5.3.0"
  }
}
